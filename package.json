{
  "name": "Word Match Game",
  "version": "1.0.0",
  "description": "Electron Application",
  "main": "main.js",
  "author": "Andy Nguyen",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win"
  },
  "dependencies": {
    "debug": "^4.3.7",
    "simple-keyboard": "^3.8.17",
    "supports-color": "^9.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.electron.app",
    "productName": "Electron App",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Electron App"
    }
  }
}
